{
	"name": "sankey-builder",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "tsc --noEmit",
		"dev": "bun ./index.html",
		"build": "rm -rf dist && bun build ./index.html --minify --outdir=dist && bun scripts/third-party-licenses.ts dist/third-party-licenses.html",
		"test": "vitest run",
		"test:dist": "vitest run tests/build/dist.test.ts",
		"test:unit": "vitest run --exclude tests/build/dist.test.ts",
		"test:browser": "playwright test",
		"test:browser:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "1.65.0",
		"@types/culori": "4.0.1",
		"@types/d3-sankey": "^0.12.0",
		"@types/sortablejs": "^1.15.9",
		"happy-dom": "^21.0.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"trustedDependencies": ["@biomejs/biome"],
	"dependencies": {
		"culori": "4.0.2",
		"d3-sankey": "^0.12.3",
		"lucide-preact": "1.61.0",
		"open-color": "1.9.1",
		"preact": "^10.29.8",
		"sortablejs": "^1.15.7"
	}
}
