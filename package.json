{
	"name": "sankey-builder",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "tsc --noEmit",
		"dev": "bun ./index.html",
		"build": "rm -rf dist && bun build ./index.html --minify --outdir=dist && bun scripts/third-party-licenses.ts dist/third-party-licenses.html",
		"test": "vitest run",
		"test:dist": "vitest run tests/build/dist.test.ts",
		"test:unit": "vitest run --exclude tests/build/dist.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/d3-sankey": "^0.12.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-selection": "^3.0.11",
		"@types/sortablejs": "^1.15.9",
		"happy-dom": "^20.11.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"trustedDependencies": ["@biomejs/biome"],
	"dependencies": {
		"d3-sankey": "^0.12.3",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"d3-selection": "^3.0.0",
		"preact": "^10.29.8",
		"sortablejs": "^1.15.7"
	}
}
