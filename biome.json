{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": ["**", "!**/dist", "!**/playwright-report", "!**/test-results"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"json": { "formatter": { "expand": "auto" } },
	"markdown": { "formatter": { "enabled": false } },
	"linter": {
		"enabled": true,
		"domains": { "react": "recommended" },
		"rules": {
			"preset": "recommended"
		}
	}
}
